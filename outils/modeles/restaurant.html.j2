[% extends "base.html.j2" %]
[# Restaurant, winstub, brasserie, bar, crêperie, tartes flambées. Thème sombre, ouverture en iris. #]
[% block css %]
:root{--titre-poids:[% if roles.titre == "Fraunces" %]600[% else %]400[% endif %];--rayon:.4rem;
  --fond:[[ c.sombre ]];--fond2:color-mix(in srgb,[[ c.sombre ]] 88%,#fff);--encre:#F6EEE3;--doux:#D4C8B8;--trait:rgba(246,238,227,.16);
  --clair:[[ c.fond ]];--clair-encre:[[ c.encre ]];--clair-doux:[[ c.doux ]];--feu:[[ c.accent ]];--feu-encre:[[ c.accent_encre ]]}
.btn--p{background:var(--feu);color:var(--feu-encre)}
.btn--p:hover{background:color-mix(in srgb,var(--feu) 85%,#fff)}
.top.is-solid{background:color-mix(in srgb,var(--fond) 96%,transparent)}
.menu-btn{background:var(--encre);color:var(--fond)}
.demo{background:#000}
.hero{position:relative;min-height:100vh;min-height:100svh;display:flex;align-items:flex-end;overflow:hidden;isolation:isolate;margin-top:-4.5rem}
.hero__media{position:absolute;inset:-6% 0 0 0;z-index:-3;will-change:transform}
.hero__media img{width:100%;height:100%;object-fit:cover}
.hero__ombre{position:absolute;inset:0;z-index:-2;background:radial-gradient(120% 70% at 18% 100%,color-mix(in srgb,var(--feu) 30%,transparent) 0%,transparent 55%),linear-gradient(to top,color-mix(in srgb,var(--fond) 96%,transparent) 0%,color-mix(in srgb,var(--fond) 70%,transparent) 34%,color-mix(in srgb,var(--fond) 16%,transparent) 64%,color-mix(in srgb,var(--fond) 45%,transparent) 100%)}
.hero__braises{position:absolute;inset:0;z-index:-1;width:100%;height:100%;pointer-events:none}
.hero__in{width:100%;padding-top:9rem;padding-bottom:clamp(2.5rem,7vh,5.5rem)}
.hero__kicker{font-size:1.1875rem;font-weight:500;margin-bottom:.75rem;text-shadow:0 1px 12px rgba(0,0,0,.6)}
.hero h1{font-size:clamp(3.2rem,8vw + 1rem,8.4rem);line-height:1.02;text-shadow:0 0 42px color-mix(in srgb,var(--feu) 35%,transparent),0 2px 0 rgba(0,0,0,.25)}
.hero h1 .ln{display:block}
.hero__tag{font-size:clamp(1.125rem,.6vw + 1rem,1.375rem);line-height:1.5;max-width:40ch;margin:1.5rem 0 1.75rem}
.carte{background:var(--clair);color:var(--clair-encre)}
.carte .lead{color:var(--clair-doux)}
.carte__grid{display:grid;gap:3rem}
@media (min-width:900px){.carte__grid{grid-template-columns:1.3fr 1fr;gap:5rem;align-items:start}}
.plats{list-style:none;margin:2rem 0 0;padding:0}
.plats li{display:grid;grid-template-columns:1fr auto;gap:.3rem 1.5rem;padding:1.25rem 0;border-top:1px solid rgba(0,0,0,.14)}
.plats li:last-child{border-bottom:1px solid rgba(0,0,0,.14)}
.plats h3{font-size:1.45rem}
.plats p{grid-column:1;color:var(--clair-doux)}
.plats .prix{grid-column:2;grid-row:1;font-weight:500;font-variant-numeric:tabular-nums;white-space:nowrap}
.carte__photo img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:.6rem}
.carte__note{margin-top:1.5rem;background:var(--fond);color:var(--encre);border-radius:.6rem;padding:1.5rem}
.carte__note h3{font-size:1.4rem;margin-bottom:.4rem;color:var(--feu)}
.lieu__grid{display:grid;gap:3rem;align-items:center}
@media (min-width:900px){.lieu__grid{grid-template-columns:1fr 1.25fr;gap:4rem}}
.mosaique{display:grid;grid-template-columns:repeat(6,1fr);grid-auto-rows:clamp(110px,14vw,170px);gap:.6rem}
.mosaique img{width:100%;height:100%;object-fit:cover;border-radius:.4rem}
.mosaique img:nth-child(1){grid-column:span 4;grid-row:span 2}
.mosaique img:nth-child(2){grid-column:span 2;grid-row:span 1}
.mosaique img:nth-child(3){grid-column:span 2;grid-row:span 1}
.mosaique img:nth-child(4){grid-column:span 3;grid-row:span 1}
.mosaique img:nth-child(5){grid-column:span 3;grid-row:span 1}
.faits{list-style:none;margin:2rem 0 0;padding:0}
.faits li{display:grid;grid-template-columns:7rem 1fr;gap:1rem;padding:1rem 0;border-top:1px solid var(--trait)}
.faits strong{font-family:var(--f-titre);font-weight:var(--titre-poids);font-size:1.3rem;color:var(--feu)}
.visite{background:var(--clair);color:var(--clair-encre)}
.visite .hours th,.visite .hours td{border-bottom-color:rgba(0,0,0,.14)}
.visite .hours tr.is-today{background:color-mix(in srgb,var(--feu) 18%,#fff)}
.visite .contact-carte{background:#fff;color:var(--clair-encre)}
.visite .btn--t{color:var(--clair-encre)}
.visite .preuve{color:var(--clair-doux)}
.mbar{background:color-mix(in srgb,var(--fond) 97%,transparent)}
.foot{background:#000}
/* intro : rideau sombre, sceau, anneaux, puis ouverture en iris */
@property --trou{syntax:"<length>";inherits:false;initial-value:0px}
.f-restaurant .intro{display:none}
.js-intro.js .f-restaurant .intro,.js-intro .f-restaurant .intro{display:grid;place-items:center}
.i-rideau{position:absolute;inset:0;background:#070605;-webkit-mask-image:radial-gradient(circle at 50% 50%,transparent var(--trou),#000 calc(var(--trou) + 2px));mask-image:radial-gradient(circle at 50% 50%,transparent var(--trou),#000 calc(var(--trou) + 2px));animation:iris 1.2s cubic-bezier(.7,0,.84,0) 1.3s forwards,rideauOut .3s linear 2.3s forwards}
.i-lueur{position:absolute;left:50%;bottom:-30vh;width:140vmax;height:80vmax;transform:translateX(-50%);background:radial-gradient(closest-side,color-mix(in srgb,var(--feu) 55%,transparent),color-mix(in srgb,var(--feu) 12%,transparent) 55%,transparent);opacity:0;animation:lueur 1.4s cubic-bezier(.16,1,.3,1) .1s forwards}
.i-anneaux{position:absolute;left:50%;top:50%;width:0;height:0}
.i-anneaux i{position:absolute;left:0;top:0;border:1.5px solid color-mix(in srgb,var(--feu) 70%,#fff);border-radius:50%;transform:translate(-50%,-50%) scale(.2);opacity:0;animation:anneau 1.4s cubic-bezier(.16,1,.3,1) both}
.i-anneaux i:nth-child(1){width:26vmin;height:26vmin;animation-delay:.35s}
.i-anneaux i:nth-child(2){width:38vmin;height:38vmin;animation-delay:.5s}
.i-anneaux i:nth-child(3){width:52vmin;height:52vmin;animation-delay:.65s}
.i-sceau{position:relative;width:clamp(120px,18vmin,180px);aspect-ratio:1;border-radius:50%;display:grid;place-items:center;background:#0d0b09;box-shadow:0 0 80px color-mix(in srgb,var(--feu) 45%,transparent);opacity:0;transform:scale(.9);animation:sceauIn .8s cubic-bezier(.16,1,.3,1) .2s forwards,sceauOut .7s cubic-bezier(.7,0,.84,0) 1.3s forwards;overflow:hidden}
.i-sceau img{width:100%;height:100%;object-fit:cover}
.i-sceau span{font-family:var(--f-titre);font-weight:var(--titre-poids);color:var(--encre);font-size:clamp(2.6rem,7vmin,4rem)}
@keyframes iris{to{--trou:120vmax}}
@keyframes rideauOut{to{opacity:0}}
@keyframes lueur{to{opacity:1}}
@keyframes anneau{0%{opacity:0;transform:translate(-50%,-50%) scale(.2)}40%{opacity:.7}100%{opacity:0;transform:translate(-50%,-50%) scale(1)}}
@keyframes sceauIn{to{opacity:1;transform:scale(1)}}
@keyframes sceauOut{to{opacity:0;transform:scale(1.15)}}
[% endblock %]
[% block intro %]
  <div class="i-rideau"><div class="i-lueur"></div></div>
  <div class="i-anneaux"><i></i><i></i><i></i></div>
  <div class="i-sceau">[% if f.logo %]<img src="[[ img(f.logo) ]]" alt="">[% else %]<span>[[ f.initiales|default(f.nom[:1]) ]]</span>[% endif %]</div>
[% endblock %]
[% block hero %]
  <section class="hero" id="accueil">
    <div class="hero__media" id="media"><img src="[[ img(f.hero) ]]" alt="[[ f.hero_alt|default(f.nom) ]]"[% if f.hero_pos %] style="object-position:[[ f.hero_pos ]]"[% endif %]></div>
    <div class="hero__ombre"></div>
    [% if f.braises|default(true) %]<canvas class="hero__braises" id="braises" aria-hidden="true"></canvas>[% endif %]
    <div class="page hero__in">
      <p class="hero__kicker">[[ f.accroche ]]</p>
      <h1>[% for ln in f.titre_lignes|default([f.nom]) %]<span class="ln">[[ ln ]]</span>[% endfor %]</h1>
      [% if f.slogan %]<p class="hero__tag">[[ f.slogan ]]</p>[% endif %]
      <p class="status" data-status><span class="status__dot"></span><span data-status-text></span></p>
      <div class="actions">
        <a class="btn btn--p" href="[[ cta.href ]]"[% if cta.ext %] target="_blank" rel="noopener"[% endif %]>[% if cta.ext or not f.tel %][[ cta.label ]][% else %]Appeler le [[ f.tel_affiche ]][% endif %]</a>
        <a class="btn btn--t" href="#carte">[[ f.bouton_offre or "Voir la carte" ]]</a>
      </div>
      [% if f.note %]<p class="preuve" style="color:var(--doux)">Noté [[ f.note ]] sur 5 sur Google ([[ f.avis ]] avis)[% if f.preuve_extra %], [[ f.preuve_extra ]][% endif %].</p>[% endif %]
    </div>
  </section>
[% endblock %]
[% block sections %]
  <section class="sec carte" id="carte">
    <div class="page carte__grid">
      <div>
        <h2>[[ f.offre_titre|default("La carte") ]]</h2>
        [% if f.offre_intro %]<p class="lead">[[ f.offre_intro ]]</p>[% endif %]
        <ul class="plats">
          [% for o in f.offre %]<li><h3>[[ o.titre ]]</h3>[% if o.prix %]<span class="prix">[[ o.prix ]]</span>[% endif %][% if o.texte %]<p>[[ o.texte ]]</p>[% endif %]</li>[% endfor %]
        </ul>
      </div>
      <div>
        <div class="carte__photo"><img src="[[ img(f.photos[0].img) ]]" alt="[[ f.photos[0].alt ]]"></div>
        [% if f.encart %]<div class="carte__note"><h3>[[ f.encart.titre ]]</h3><p>[[ f.encart.texte ]]</p></div>[% endif %]
      </div>
    </div>
  </section>
  <section class="sec" id="lieu">
    <div class="page lieu__grid">
      <div>
        <h2>[[ (f.bloc2 or {}).titre|default("Le lieu") ]]</h2>
        [% if f.bloc2 %]<p class="lead" style="color:var(--doux)">[[ f.bloc2.texte ]]</p>
        [% if f.bloc2.faits %]<ul class="faits">[% for x in f.bloc2.faits %]<li><strong>[[ x.k ]]</strong><span>[[ x.v ]]</span></li>[% endfor %]</ul>[% endif %][% endif %]
      </div>
      <div class="mosaique">
        [% for p in (f.photos[1:6] if f.photos|length > 1 else f.photos) %]<img src="[[ img(p.img) ]]" alt="[[ p.alt ]]"[% if p.pos %] style="object-position:[[ p.pos ]]"[% endif %]>[% endfor %]
      </div>
    </div>
  </section>
[% endblock %]
[% block js %]
  var media=document.getElementById("media");
  window.__auDefil(function(y){ if(y < window.innerHeight*1.2) media.style.transform="translateY("+(y*0.28).toFixed(1)+"px)"; });
  var cv=document.getElementById("braises");
  if(cv && !reduce){
    var cx=cv.getContext("2d"), W, Hh, parts=[], vis=true;
    function taille(){ var r=window.devicePixelRatio||1; W=cv.clientWidth; Hh=cv.clientHeight; cv.width=W*r; cv.height=Hh*r; cx.setTransform(r,0,0,r,0,0); }
    taille(); window.addEventListener("resize",taille);
    for(var i=0;i<38;i++) parts.push({x:Math.random(),y:Math.random(),v:.2+Math.random()*.6,r:.6+Math.random()*1.8,a:Math.random()});
    new IntersectionObserver(function(e){ vis=e[0].isIntersecting; }).observe(cv);
    var feu=getComputedStyle(document.documentElement).getPropertyValue("--feu").trim()||"#FF7A2F";
    (function anim(){
      if(vis){ cx.clearRect(0,0,W,Hh);
        parts.forEach(function(p){ p.y-=p.v/Hh*2.2; p.x+=Math.sin((p.y+p.a)*12)*.0006; if(p.y<-.02){p.y=1.02;p.x=Math.random();}
          cx.globalAlpha=.25+.55*Math.abs(Math.sin(p.a+p.y*6)); cx.fillStyle=feu; cx.beginPath(); cx.arc(p.x*W,p.y*Hh,p.r,0,6.283); cx.fill(); });
      }
      requestAnimationFrame(anim);
    })();
  }
[% endblock %]
