<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>[[ f.nom ]] – Maquette de site</title>
<meta name="description" content="[[ f.description ]]">
<meta name="theme-color" content="[[ c.fond ]]">
[% if f.logo %]<link rel="icon" href="[[ img(f.logo) ]]">[% endif %]
<script>
  (function () {
    var d = document.documentElement;
    d.classList.add("js");
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) d.classList.add("js-intro");
  })();
</script>
<style>
[% for p in faces %]
@font-face{font-family:"[[ p.css ]]";font-style:[[ p.style ]];font-weight:[[ p.poids ]];font-display:swap;src:url({{font:[[ p.key ]]}}) format("woff2")}
[% endfor %]
:root{
  --principale:[[ c.principale ]];--bouton:[[ c.bouton ]];--bouton-survol:[[ c.bouton_survol ]];
  --accent:[[ c.accent ]];--accent-encre:[[ c.accent_encre ]];
  --fond:[[ c.fond ]];--fond2:[[ c.fond2 ]];--encre:[[ c.encre ]];--doux:[[ c.doux ]];--trait:[[ c.trait ]];
  --sombre:[[ c.sombre ]];--sur-sombre:[[ c.sur_sombre ]];--sur-sombre-doux:[[ c.sur_sombre_doux ]];
  --f-titre:"[[ roles.titre ]]", Georgia, serif;
  --f-texte:"[[ roles.texte ]]", system-ui, sans-serif;
  [% if roles.script %]--f-script:"[[ roles.script ]]", cursive;[% endif %]
  [% if roles.carte %]--f-carte:"[[ roles.carte ]]", var(--f-texte);[% else %]--f-carte:var(--f-texte);[% endif %]
  --titre-style:normal;--titre-poids:400;--rayon:.6rem;
  --ease-out:cubic-bezier(.16,1,.3,1);--ease-in:cubic-bezier(.7,0,.84,0);
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth;scroll-padding-top:5rem}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{margin:0;background:var(--fond);color:var(--encre);font:400 1rem/1.6 var(--f-texte);overflow-x:hidden}
img{display:block;max-width:100%}
a{color:inherit}
:focus-visible{outline:3px solid var(--bouton);outline-offset:3px;border-radius:4px}
h1,h2,h3{font-family:var(--f-titre);font-style:var(--titre-style);font-weight:var(--titre-poids);line-height:1.1;margin:0}
p{margin:0}
.page{width:100%;max-width:1280px;margin-inline:auto;padding-inline:clamp(20px,5vw,56px)}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.demo{background:var(--sombre);color:var(--sur-sombre);font-size:.875rem;line-height:1.45;text-align:center;padding:.6rem 1rem}
.demo strong{font-weight:500;color:#fff}
.top{position:sticky;top:0;z-index:40;transition:background-color .2s ease,box-shadow .2s ease}
.top.is-solid{background:color-mix(in srgb,var(--fond) 96%,transparent);box-shadow:0 1px 0 var(--trait)}
.top__in{display:flex;align-items:center;gap:1.25rem;min-height:4.5rem}
.brand{display:flex;align-items:center;gap:.7rem;text-decoration:none;margin-right:auto;min-height:44px;min-width:0}
.brand img{width:3rem;height:3rem;object-fit:contain}
.brand span{font-family:var(--f-titre);font-style:var(--titre-style);font-size:1.2rem;line-height:1.1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.nav{display:none;gap:1.6rem}
.nav a{text-decoration:none;font-weight:500;padding:.6rem 0;border-bottom:2px solid transparent}
.nav a:hover{border-bottom-color:var(--principale)}
.top .btn{display:none}
.menu-btn{flex:none;display:inline-grid;place-items:center;width:44px;height:44px;border:0;border-radius:50%;background:var(--encre);color:var(--fond);cursor:pointer}
.menu-btn svg{width:22px;height:22px}
.nav-panel{display:none;flex-direction:column;padding:.5rem clamp(20px,5vw,56px) 1.25rem;background:var(--fond);border-bottom:1px solid var(--trait)}
.nav-panel.is-open{display:flex}
.nav-panel a{padding:.85rem 0;text-decoration:none;font-weight:500;border-bottom:1px solid var(--trait)}
@media (min-width:900px){.nav{display:flex}.top .btn{display:inline-flex}.menu-btn{display:none}.nav-panel,.nav-panel.is-open{display:none}}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.55rem;min-height:48px;padding:.8rem 1.35rem;border-radius:var(--rayon);font:500 1rem/1.2 var(--f-texte);text-decoration:none;border:0;cursor:pointer;transition:background-color .15s ease,color .15s ease}
.btn svg{width:1.15em;height:1.15em;flex:none}
.btn--p{background:var(--bouton);color:#fff}
.btn--p:hover{background:var(--bouton-survol)}
.btn--t{box-shadow:inset 0 0 0 2px currentColor;background:transparent}
.btn--t:hover{background:var(--encre);color:var(--fond);box-shadow:inset 0 0 0 2px var(--encre)}
.actions{display:flex;flex-wrap:wrap;gap:.75rem}
.status{display:none;align-items:center;gap:.6rem;font-weight:500;margin-bottom:1.5rem}
.status.is-ready{display:inline-flex}
.status__dot{flex:none;width:.7rem;height:.7rem;border-radius:50%;background:#C2413A}
.status[data-open="1"] .status__dot{background:#2E9F62;box-shadow:0 0 0 .3rem rgba(46,159,98,.22)}
.preuve{margin-top:1.5rem;font-size:.875rem;color:var(--doux)}
.sec{padding:clamp(4rem,8vw,7rem) 0}
.sec h2{font-size:clamp(2.3rem,3.2vw + 1rem,3.8rem)}
.lead{color:var(--doux);max-width:54ch;margin-top:1rem;font-size:1.0625rem}
.visite__grid{display:grid;gap:3rem}
@media (min-width:900px){.visite__grid{grid-template-columns:1fr 1fr;gap:5rem}}
.hours{width:100%;border-collapse:collapse;margin-top:1.75rem;font-size:1.0625rem}
.hours th,.hours td{text-align:left;padding:.8rem .9rem;border-bottom:1px solid var(--trait);font-weight:400}
.hours th{width:9.5rem}
.hours td{font-variant-numeric:tabular-nums}
.hours tr.is-today{background:var(--fond2)}
.hours tr.is-today th,.hours tr.is-today td{font-weight:500}
.contact-carte{margin-top:1.75rem;background:var(--fond2);border-radius:1rem;padding:clamp(1.5rem,4vw,2.5rem)}
.contact-carte address{font-style:normal;font-size:1.25rem;line-height:1.45;margin-bottom:1rem}
.contact-carte .lignes{margin-bottom:1.5rem;line-height:1.9}
.contact-carte .lignes a{text-underline-offset:3px;overflow-wrap:anywhere}
.foot{background:var(--sombre);color:var(--sur-sombre);padding:3.5rem 0 6rem}
.foot__grid{display:grid;gap:1.75rem;align-items:start}
@media (min-width:900px){.foot__grid{grid-template-columns:auto 1fr 1.2fr;gap:3rem;align-items:center}.foot{padding-bottom:3.5rem}}
.foot__logo{width:5.5rem;height:5.5rem;object-fit:contain}
.foot__nom{font-family:var(--f-titre);font-style:var(--titre-style);font-size:1.6rem;color:#fff}
.foot strong{color:#fff;font-weight:500}
.foot__liens{display:flex;flex-wrap:wrap;gap:1.25rem;margin-top:.6rem}
.foot__liens a{display:inline-flex;align-items:center;min-height:44px;font-weight:500}
.foot__demo{font-size:.875rem;color:var(--sur-sombre-doux);max-width:52ch}
.mbar{position:fixed;left:0;right:0;bottom:0;z-index:45;display:flex;gap:.6rem;padding:.7rem clamp(12px,4vw,20px) calc(.7rem + env(safe-area-inset-bottom));background:color-mix(in srgb,var(--fond) 97%,transparent);box-shadow:0 -1px 0 var(--trait);transform:translateY(110%);transition:transform .2s var(--ease-out)}
.mbar.is-on{transform:none}
.mbar .btn{flex:1}
@media (min-width:900px){.mbar{display:none}}
.intro{display:none}
.js-intro .intro{display:block;position:fixed;inset:0;z-index:100;cursor:pointer;overflow:hidden}
.intro__skip{position:absolute;left:0;right:0;bottom:1.75rem;text-align:center;font-size:.875rem;z-index:5;animation:skipOut .2s ease-in 1.4s forwards}
.intro__skip span{background:rgba(255,255,255,.92);color:#222;padding:.25rem .7rem;border-radius:.3rem}
@keyframes skipOut{to{opacity:0}}
.intro-skip .intro{opacity:0;pointer-events:none;transition:opacity .15s ease-in}
.intro-skip .intro *{animation:none!important}
@media (prefers-reduced-motion:reduce){.intro{display:none!important}}
[% block css %][% endblock %]
</style>
</head>
<body class="f-[[ famille ]]">

<div class="intro" id="intro" aria-hidden="true">
[% block intro %][% endblock %]
  <p class="intro__skip"><span>Cliquer pour passer</span></p>
</div>

<div class="demo" role="note"><strong>Maquette réalisée par Gaspard Culli</strong> pour [[ f.nom ]]. Ce site n'est pas encore en ligne.</div>

<header class="top" id="top">
  <div class="page top__in">
    <a class="brand" href="#accueil">[% if f.logo %]<img src="[[ img(f.logo) ]]" alt="">[% endif %]<span>[[ f.nom ]]</span></a>
    <nav class="nav" aria-label="Navigation principale">
      [% for id, label in nav %]<a href="#[[ id ]]">[[ label ]]</a>[% endfor %]
    </nav>
    <a class="btn btn--p" href="[[ cta.href ]]"[% if cta.ext %] target="_blank" rel="noopener"[% endif %]>[[ cta.label ]]</a>
    <button class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="nav-panel" aria-label="Ouvrir le menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>
  <nav class="nav-panel" id="nav-panel" aria-label="Menu">
    [% for id, label in nav %]<a href="#[[ id ]]">[[ label ]]</a>[% endfor %]
    [% if f.tel %]<a href="tel:[[ f.tel ]]">Appeler le [[ f.tel_affiche ]]</a>[% else %]<a href="mailto:[[ f.email ]]">Nous écrire</a>[% endif %]
  </nav>
</header>

<main>
[% block hero %][% endblock %]
[% block sections %][% endblock %]
  <section class="sec visite" id="horaires">
    <div class="page visite__grid">
      <div>
        <h2>Horaires</h2>
        <table class="hours">
          {{hours}}
        </table>
      </div>
      <div id="acces">
        <h2>Nous trouver</h2>
        <div class="contact-carte">
          <address>[[ f.adresse ]]<br>[[ f.cp_ville ]]</address>
          <p class="lignes">[% if f.tel %]<a href="tel:[[ f.tel ]]">[[ f.tel_affiche ]]</a><br>[% endif %][% if f.email %]<a href="mailto:[[ f.email ]]">[[ f.email ]]</a>[% endif %]</p>
          <div class="actions">
            [% if f.tel %]<a class="btn btn--p" href="tel:[[ f.tel ]]">Appeler</a>[% else %]<a class="btn btn--p" href="mailto:[[ f.email ]]">Nous écrire</a>[% endif %]
            <a class="btn btn--t" href="[[ itin ]]" target="_blank" rel="noopener">Calculer l'itinéraire</a>
          </div>
          [% if f.note %]<p class="preuve">Noté [[ f.note ]] sur 5 sur Google, [[ f.avis ]] avis.</p>[% endif %]
        </div>
      </div>
    </div>
  </section>
</main>

<footer class="foot">
  <div class="page foot__grid">
    [% if f.logo %]<img class="foot__logo" src="[[ img(f.logo_blanc or f.logo) ]]" alt="Logo de [[ f.nom ]]">[% else %]<p class="foot__nom">[[ f.nom ]]</p>[% endif %]
    <div>
      <p><strong>[[ f.nom ]]</strong><br>[[ f.adresse ]], [[ f.cp_ville ]][% if f.tel %]<br><a href="tel:[[ f.tel ]]">[[ f.tel_affiche ]]</a>[% endif %]</p>
      <div class="foot__liens">
        [% if f.facebook %]<a href="[[ f.facebook ]]" target="_blank" rel="noopener">Facebook</a>[% endif %]
        [% if f.instagram %]<a href="[[ f.instagram ]]" target="_blank" rel="noopener">Instagram</a>[% endif %]
      </div>
    </div>
    <p class="foot__demo">Maquette réalisée par Gaspard Culli pour présenter un projet de site à [[ f.nom ]]. Photos issues des pages publiques de l'établissement. Ce site n'est pas encore en ligne.</p>
  </div>
</footer>

<div class="mbar" id="mbar">
  <a class="btn btn--p" href="[[ cta.href ]]"[% if cta.ext %] target="_blank" rel="noopener"[% endif %]>[[ cta.label ]]</a>
  <a class="btn btn--t" href="[[ itin ]]" target="_blank" rel="noopener">Itinéraire</a>
</div>

<script>
(function () {
  var root = document.documentElement;
  var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var intro = document.getElementById("intro");
  function skip() { root.classList.add("intro-skip"); setTimeout(function(){ intro.style.display = "none"; }, 200); }
  if (root.classList.contains("js-intro")) {
    intro.addEventListener("click", skip);
    window.addEventListener("keydown", function once() { skip(); window.removeEventListener("keydown", once); });
    setTimeout(function () { intro.style.display = "none"; }, [[ intro_ms ]]);
  }
  var H = {{hours_js}};
  var JOURS = ["dimanche","lundi","mardi","mercredi","jeudi","vendredi","samedi"];
  function m(s){var p=s.split(":");return (+p[0])*60+(+p[1]);}
  function fh(s){var p=s.split(":");return (+p[0])+"h"+(p[1]==="00"?"":p[1]);}
  var now=new Date(), d=now.getDay(), t=now.getHours()*60+now.getMinutes();
  var row=document.querySelector('.hours tr[data-day="'+d+'"]'); if(row) row.classList.add("is-today");
  var label=null, open=false;
  (H[d]||[]).forEach(function(r){ if(t>=m(r[0]) && t<m(r[1])){open=true; label="Ouvert maintenant, jusqu'à "+fh(r[1]);} });
  if(!open){
    for(var i=0;i<8 && !label;i++){
      var dd=(d+i)%7, slots=H[dd]||[];
      for(var k=0;k<slots.length;k++){
        if(i>0 || m(slots[k][0])>t){ label="Fermé pour l'instant, ouvre "+(i===0?"aujourd'hui":(i===1?"demain":JOURS[dd]))+" à "+fh(slots[k][0]); break; }
      }
    }
  }
  if(label){
    document.querySelectorAll("[data-status]").forEach(function(el){
      el.setAttribute("data-open", open?"1":"0");
      el.querySelector("[data-status-text]").textContent=label;
      el.classList.add("is-ready");
    });
  }
  var mb=document.getElementById("menu-btn"), panel=document.getElementById("nav-panel");
  function setMenu(o){ panel.classList.toggle("is-open",o); mb.setAttribute("aria-expanded",o?"true":"false"); mb.setAttribute("aria-label",o?"Fermer le menu":"Ouvrir le menu"); }
  mb.addEventListener("click",function(){ setMenu(!panel.classList.contains("is-open")); });
  panel.addEventListener("click",function(e){ if(e.target.closest("a")) setMenu(false); });
  document.addEventListener("keydown",function(e){ if(e.key==="Escape" && panel.classList.contains("is-open")){ setMenu(false); mb.focus(); } });
  var top=document.getElementById("top"), mbar=document.getElementById("mbar"), ticking=false;
  var auDefil=[];
  window.__auDefil=function(fn){auDefil.push(fn);};
  function onScroll(){
    var y=window.scrollY||0;
    top.classList.toggle("is-solid", y > 40);
    mbar.classList.toggle("is-on", y > window.innerHeight*0.7);
    if(!reduce) auDefil.forEach(function(fn){fn(y);});
    ticking=false;
  }
  window.addEventListener("scroll",function(){ if(!ticking){ ticking=true; requestAnimationFrame(onScroll);} },{passive:true});
[% block js %][% endblock %]
  onScroll();
})();
</script>
</body>
</html>
