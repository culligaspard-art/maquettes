[% extends "base.html.j2" %]
[# Boulangerie, pâtisserie, chocolatier, salon de thé, glacier. #]
[% set nom_plaque = f.nom_plaque|default(f.nom) %]
[% block css %]
:root{--rayon:.5rem;--vichy:linear-gradient(90deg,color-mix(in srgb,var(--principale) 60%,transparent) 50%,transparent 50%),linear-gradient(color-mix(in srgb,var(--principale) 60%,transparent) 50%,transparent 50%);--or:#B8913A;--or-clair:#E3C77E}
.plaque{display:inline-grid;place-items:center;aspect-ratio:2.1/1;border-radius:50%;background:#fff;box-shadow:inset 0 0 0 .14em var(--or),inset 0 0 0 .22em #fff,inset 0 0 0 .27em var(--or-clair),0 .25em .6em rgba(0,0,0,.18)}
.plaque span{font-family:var(--f-script);color:var(--or);line-height:1;transform:translateY(.06em);white-space:nowrap}
.hero{margin-top:-4.5rem;padding-top:4.5rem}
.hero__grid{display:grid;gap:2.5rem;padding-top:2rem;padding-bottom:3.5rem;align-items:center}
@media (min-width:900px){.hero__grid{grid-template-columns:1fr 1fr;gap:4rem;min-height:min(84vh,760px)}}
.hero__kicker{color:var(--doux);font-weight:500;margin-bottom:1.25rem}
.hero__title .plaque{width:min(100%,25rem);font-size:[% if nom_plaque|length > 12 %]clamp(2.6rem,7vw,4.4rem)[% elif nom_plaque|length > 8 %]clamp(3.4rem,9vw,5.8rem)[% else %]clamp(4.6rem,13vw,8.4rem)[% endif %]}
.hero__tag{font-family:var(--f-titre);font-size:clamp(1.4rem,1.4vw + 1rem,2rem);line-height:1.25;margin:1.75rem 0 1.25rem;max-width:24ch}
.arche{position:relative;margin:0}
.arche img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:999px 999px 0 0}
@media (max-width:899px){.arche img{aspect-ratio:5/4;border-radius:50vw 50vw 0 0 / 30vw 30vw 0 0}}
.arche::after{content:"";display:block;height:18px;background-color:#fff;background-image:var(--vichy);background-size:18px 18px}
.band{height:22px;background-color:#fff;background-image:var(--vichy);background-size:22px 22px}
.vitrine{background:var(--fond2)}
.vitrine__head{display:grid;gap:1rem;margin-bottom:3rem}
@media (min-width:900px){.vitrine__head{grid-template-columns:1fr 1fr;align-items:end}}
.gateaux{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,1fr);gap:clamp(1rem,2.5vw,2rem)}
@media (min-width:900px){.gateaux{grid-template-columns:repeat(3,1fr)}}
.gateaux figure{margin:0}
.gateaux img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:1rem}
.gateaux figcaption{display:flex;justify-content:center;margin-top:-1.4rem;position:relative}
.gateaux figcaption span{background:#fff;border-radius:999px;padding:.55rem 1.1rem;font-size:.9375rem;font-weight:500;line-height:1.3;text-align:center;box-shadow:inset 0 0 0 1.5px var(--or),0 4px 10px rgba(0,0,0,.12)}
.maison__grid{display:grid;gap:2.5rem;align-items:center}
@media (min-width:900px){.maison__grid{grid-template-columns:1fr 1.1fr;gap:5rem}}
.maison__photo{position:relative}
.maison__photo img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:1rem}
.maison__photo .plaque{position:absolute;right:-.5rem;bottom:-1.5rem;width:9rem;font-size:[% if nom_plaque|length > 10 %]1.4rem[% else %]2.4rem[% endif %];transform:rotate(-6deg)}
.faits{list-style:none;margin:2rem 0 0;padding:0}
.faits li{display:grid;grid-template-columns:7rem 1fr;gap:1rem;padding:1rem 0;border-top:1px solid var(--trait)}
.faits li:last-child{border-bottom:1px solid var(--trait)}
.faits strong{font-family:var(--f-titre);font-weight:400;font-size:1.25rem;color:var(--bouton)}
.commande{background:var(--sombre);color:var(--sur-sombre)}
.commande__grid{display:grid;gap:2.5rem;align-items:center}
@media (min-width:900px){.commande__grid{grid-template-columns:1.1fr 1fr;gap:5rem}}
.commande h2{color:#fff}
.commande .lead{color:var(--sur-sombre-doux)}
.commande img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:50%;border:10px solid #fff}
.commande .actions{margin-top:2rem}
.contact-carte{background:#fff;box-shadow:inset 0 0 0 1.5px var(--or)}
.foot .plaque{width:8rem;font-size:[% if nom_plaque|length > 10 %]1.2rem[% else %]2.2rem[% endif %]}
/* intro : la nappe s'ouvre sur la plaque */
.nappe{position:absolute;left:0;right:0;height:50.5%;background-color:#fff;background-image:var(--vichy);background-size:clamp(26px,4vw,44px) clamp(26px,4vw,44px)}
.nappe--haut{top:0;animation:hautSort .75s cubic-bezier(.7,0,.84,0) 1.8s both}
.nappe--bas{bottom:0;background-position:0 100%;animation:basSort .75s cubic-bezier(.7,0,.84,0) 1.8s both}
.i-centre{position:absolute;inset:0;display:grid;place-items:center;align-content:center;gap:1rem;animation:centreSort .45s ease-in 1.75s both}
.i-plaque{position:relative;width:min(80vw,460px);aspect-ratio:2.1/1;opacity:0;transform:scale(.9);animation:plaqueIn .5s cubic-bezier(.16,1,.3,1) .15s both}
.i-plaque svg{position:absolute;inset:0;width:100%;height:100%}
.i-plaque .bord{fill:none;stroke:#B8913A;stroke-width:6;stroke-dasharray:1000;stroke-dashoffset:1000;animation:trace .8s cubic-bezier(.65,0,.35,1) .3s both}
.i-plaque .bord2{fill:none;stroke:#E3C77E;stroke-width:2;opacity:0;animation:fadeIn .3s ease-out .95s both}
.i-mot{position:absolute;inset:0;display:grid;place-items:center;font-family:var(--f-script);font-size:[% if nom_plaque|length > 12 %]min(7vw,3rem)[% elif nom_plaque|length > 8 %]min(10vw,4.6rem)[% else %]min(16vw,7rem)[% endif %];color:#B8913A;opacity:0;animation:fadeIn .45s ease-out .75s both;overflow:hidden;border-radius:50%;white-space:nowrap}
.i-mot::after{content:"";position:absolute;top:0;bottom:0;left:-40%;width:30%;background:linear-gradient(100deg,rgba(255,255,255,0),rgba(255,255,255,.85),rgba(255,255,255,0));animation:reflet .6s ease-in-out 1.15s both}
.i-depuis{font-family:var(--f-titre);color:#fff;font-size:clamp(1.1rem,2.6vw,1.6rem);background:var(--bouton);padding:.3rem 1rem;border-radius:.3rem;opacity:0;animation:fadeIn .35s ease-out 1.05s both}
@keyframes plaqueIn{to{opacity:1;transform:scale(1)}}
@keyframes trace{to{stroke-dashoffset:0}}
@keyframes fadeIn{to{opacity:1}}
@keyframes reflet{to{transform:translateX(560%)}}
@keyframes hautSort{to{transform:translateY(-101%)}}
@keyframes basSort{to{transform:translateY(101%)}}
@keyframes centreSort{to{opacity:0;transform:scale(1.06)}}
[% endblock %]
[% block intro %]
  <div class="nappe nappe--haut"></div>
  <div class="nappe nappe--bas"></div>
  <div class="i-centre">
    <div class="i-plaque">
      <svg viewBox="0 0 420 200"><ellipse cx="210" cy="100" rx="205" ry="95" fill="#fff"/><ellipse class="bord" cx="210" cy="100" rx="200" ry="90" pathLength="1000"/><ellipse class="bord2" cx="210" cy="100" rx="186" ry="78"/></svg>
      <div class="i-mot">[[ nom_plaque ]]</div>
    </div>
    <p class="i-depuis">[[ f.ruban|default(f.activite) ]]</p>
  </div>
[% endblock %]
[% block hero %]
  <section class="hero" id="accueil">
    <div class="page hero__grid">
      <div>
        <p class="hero__kicker">[[ f.accroche ]]</p>
        <h1 class="hero__title"><span class="plaque" aria-hidden="true"><span>[[ nom_plaque ]]</span></span><span class="sr">[[ f.nom ]]</span></h1>
        [% if f.slogan %]<p class="hero__tag">[[ f.slogan ]]</p>[% endif %]
        <p class="status" data-status><span class="status__dot"></span><span data-status-text></span></p>
        <div class="actions">
          <a class="btn btn--p" href="tel:[[ f.tel ]]">[[ f.tel_affiche ]]</a>
          <a class="btn btn--t" href="[[ itin ]]" target="_blank" rel="noopener">Itinéraire</a>
        </div>
        [% if f.note %]<p class="preuve">Noté [[ f.note ]] sur 5 sur Google ([[ f.avis ]] avis)[% if f.preuve_extra %], [[ f.preuve_extra ]][% endif %].</p>[% endif %]
      </div>
      <figure class="arche"><img src="[[ img(f.hero) ]]" alt="[[ f.hero_alt|default(f.nom) ]]"[% if f.hero_pos %] style="object-position:[[ f.hero_pos ]]"[% endif %]></figure>
    </div>
  </section>
  <div class="band" aria-hidden="true"></div>
[% endblock %]
[% block sections %]
  <section class="sec vitrine" id="vitrine">
    <div class="page">
      <div class="vitrine__head">
        <h2>[[ f.offre_titre|default("La vitrine") ]]</h2>
        [% if f.offre_intro %]<p class="lead">[[ f.offre_intro ]]</p>[% endif %]
      </div>
      <ul class="gateaux">
        [% for p in f.photos[:6] %]<li><figure><img src="[[ img(p.img) ]]" alt="[[ p.alt ]]"[% if p.pos %] style="object-position:[[ p.pos ]]"[% endif %]>[% if p.titre %]<figcaption><span>[[ p.titre ]]</span></figcaption>[% endif %]</figure></li>[% endfor %]
      </ul>
    </div>
  </section>
  [% if f.bloc2 %]
  <section class="sec" id="maison">
    <div class="page maison__grid">
      <div class="maison__photo">
        [% if f.bloc2.img %]<img src="[[ img(f.bloc2.img) ]]" alt="[[ f.bloc2.alt|default('') ]]">[% endif %]
        <span class="plaque" aria-hidden="true"><span>[[ nom_plaque ]]</span></span>
      </div>
      <div>
        <h2>[[ f.bloc2.titre ]]</h2>
        <p class="lead">[[ f.bloc2.texte ]]</p>
        [% if f.bloc2.faits %]<ul class="faits">[% for x in f.bloc2.faits %]<li><strong>[[ x.k ]]</strong><span>[[ x.v ]]</span></li>[% endfor %]</ul>[% endif %]
      </div>
    </div>
  </section>
  [% endif %]
  [% if f.commande %]
  <section class="sec commande" id="commande">
    <div class="page commande__grid">
      <div>
        <h2>[[ f.commande.titre ]]</h2>
        <p class="lead">[[ f.commande.texte ]]</p>
        <div class="actions"><a class="btn btn--p" href="tel:[[ f.tel ]]">Appeler le [[ f.tel_affiche ]]</a></div>
      </div>
      [% if f.commande.img %]<img src="[[ img(f.commande.img) ]]" alt="[[ f.commande.alt|default('') ]]">[% endif %]
    </div>
  </section>
  [% endif %]
[% endblock %]
