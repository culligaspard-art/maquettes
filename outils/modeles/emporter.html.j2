[% extends "base.html.j2" %]
[# À emporter : pizzeria, snack, burger, kebab, traiteur, food truck. #]
[% block css %]
:root{--rayon:.6rem;--kraft:[[ f.kraft|default("#D6B998") ]];--kraft-fonce:[[ f.kraft_fonce|default("#B9946C") ]]}
.hero{background:var(--kraft);margin-top:-4.5rem;padding-top:4.5rem;overflow:hidden;position:relative}
.hero::before{content:"";position:absolute;inset:clamp(10px,1.6vw,18px);border:2px dashed rgba(0,0,0,.2);border-radius:14px;pointer-events:none}
.hero__grid{display:grid;gap:2rem;padding-top:2.5rem;padding-bottom:4rem;align-items:center;position:relative}
@media (min-width:900px){.hero__grid{grid-template-columns:1.1fr 1fr;gap:2rem;min-height:min(84vh,740px)}}
.hero__kicker{font-family:var(--f-carte);font-weight:600;font-size:1.2rem;color:var(--encre);margin-bottom:.75rem}
.hero__title{font-size:clamp(2.8rem,7.4vw,6.2rem);line-height:.98;color:var(--bouton);text-shadow:.045em .045em 0 var(--fond)}
.hero__title .ln{display:block}
.hero__tag{font-size:clamp(1.0625rem,.6vw + .95rem,1.3rem);line-height:1.5;max-width:34ch;margin:1.25rem 0 1.5rem}
.hero .preuve{color:var(--encre);opacity:.75}
.plat{position:relative;width:min(100%,540px);aspect-ratio:1;margin-inline:auto}
.plat .assiette{position:absolute;inset:0;border-radius:50%;background:var(--kraft-fonce);box-shadow:inset 0 0 0 10px rgba(0,0,0,.08)}
.plat .tourne{position:absolute;inset:5%;will-change:transform}
.plat .tourne img{width:100%;height:100%;object-fit:cover;border-radius:50%;filter:drop-shadow(0 18px 24px rgba(0,0,0,.3))}
.plat .sceau{position:absolute;right:-2%;bottom:-2%;width:30%;transform:rotate(-12deg);filter:drop-shadow(0 6px 10px rgba(0,0,0,.25))}
.carte__head{display:grid;gap:1rem;margin-bottom:3rem}
@media (min-width:900px){.carte__head{grid-template-columns:1fr 1fr;align-items:end}}
.carte h2{color:var(--bouton)}
.carte__cols{columns:1;column-gap:5rem}
@media (min-width:900px){.carte__cols{columns:2}}
.groupe{break-inside:avoid;margin-bottom:2.5rem}
.groupe h3{font-family:var(--f-carte);font-weight:600;font-size:1.5rem;color:var(--encre);margin:0 0 .5rem;padding-bottom:.6rem;border-bottom:2px solid var(--encre)}
.plats{list-style:none;margin:0;padding:0}
.plats li{padding:1rem 0;border-bottom:1px solid var(--trait);break-inside:avoid}
.plat__ligne{display:flex;align-items:baseline;gap:.6rem}
.plat__nom{font-family:var(--f-carte);font-weight:600;font-size:1.25rem;line-height:1.2}
.plat__ligne::after{content:"";order:1;flex:1;border-bottom:2px dotted rgba(0,0,0,.3);transform:translateY(-.3rem)}
.plat__prix{order:2;font-family:var(--f-carte);font-weight:600;font-size:1.15rem;font-variant-numeric:tabular-nums;white-space:nowrap}
.plat__desc{color:var(--doux);font-size:.9375rem;margin-top:.15rem}
.carte__notes{display:grid;gap:.6rem;font-size:.9375rem;color:var(--doux);break-inside:avoid}
.carte__notes strong{color:var(--encre);font-weight:500}
.moment{background:var(--sombre);color:var(--sur-sombre)}
.moment h2{color:#fff}
.moment .lead{color:var(--sur-sombre-doux)}
.moment__grid{list-style:none;margin:3rem 0 0;padding:0;display:grid;gap:2.5rem}
@media (min-width:760px){.moment__grid{grid-template-columns:repeat(3,1fr);gap:2rem}}
.moment__grid img{width:min(78%,280px);margin:0 auto 1.25rem;aspect-ratio:1;object-fit:cover;border-radius:50%;filter:drop-shadow(0 16px 22px rgba(0,0,0,.35))}
.moment__grid h3{font-size:1.6rem;color:var(--accent);text-align:center}
.moment__grid p{text-align:center;color:var(--sur-sombre-doux);max-width:32ch;margin:.5rem auto 0}
.cmd__grid{display:grid;gap:3rem}
@media (min-width:900px){.cmd__grid{grid-template-columns:1fr 1.3fr;gap:5rem;align-items:start}}
.cmd h2{color:var(--bouton)}
.etapes{list-style:none;margin:0;padding:0;counter-reset:e;display:grid;gap:1.25rem}
.etapes li{counter-increment:e;display:grid;grid-template-columns:3.25rem 1fr;gap:1rem;align-items:start;background:#fff;border-radius:1rem;padding:1.25rem 1.25rem 1.25rem 1rem;box-shadow:0 1px 0 var(--trait)}
.etapes li::before{content:counter(e);display:grid;place-items:center;width:3.25rem;height:3.25rem;border-radius:50%;background:var(--bouton);color:#fff;font-family:var(--f-titre);font-size:1.4rem}
.etapes h3{font-family:var(--f-carte);font-weight:600;font-size:1.3rem;margin-bottom:.2rem}
.etapes p{color:var(--doux)}
.etapes a{color:var(--bouton);font-weight:500;text-underline-offset:3px}
.visite{background:var(--fond2)}
.contact-carte{background:var(--kraft)}
/* intro : la boîte s'ouvre */
.f-emporter .intro{perspective:1600px;perspective-origin:50% 0%;animation:introOut .4s ease-in 2.25s both}
.box__in{position:absolute;inset:0;background:radial-gradient(circle at 50% 52%,var(--kraft) 0%,var(--kraft-fonce) 75%);display:grid;place-items:center}
.box__in .pz{width:min(62vmin,460px);aspect-ratio:1;transform:rotate(-90deg) scale(.84);animation:pzIn 1.3s cubic-bezier(.16,1,.3,1) .7s both}
.box__in .pz img{width:100%;height:100%;object-fit:cover;border-radius:50%;filter:drop-shadow(0 22px 30px rgba(0,0,0,.45))}
.vapeur{position:absolute;left:50%;top:50%;width:min(62vmin,460px);height:1px;transform:translate(-50%,-30%)}
.vapeur i{position:absolute;bottom:0;width:22%;height:22vmin;border-radius:50%;background:radial-gradient(ellipse at 50% 60%,rgba(255,255,255,.85),rgba(255,255,255,0) 68%);opacity:0;animation:vapeur 1.1s ease-out both}
.vapeur i:nth-child(1){left:18%;animation-delay:1.35s}
.vapeur i:nth-child(2){left:40%;animation-delay:1.5s}
.vapeur i:nth-child(3){left:62%;animation-delay:1.42s}
.box__lid{position:absolute;inset:0;background:var(--kraft);transform-origin:50% 0%;animation:lid 1.1s cubic-bezier(.65,0,.35,1) .45s both;display:grid;place-items:center;align-content:center;gap:1.25rem;backface-visibility:hidden}
.box__lid::before{content:"";position:absolute;inset:clamp(14px,2.4vw,26px);border:3px dashed rgba(0,0,0,.22);border-radius:16px}
.box__lid img{width:min(42vmin,300px);height:auto;mix-blend-mode:multiply}
.box__lid .tampon{font-family:var(--f-titre);color:var(--bouton);font-size:clamp(2rem,7vmin,4rem);text-align:center;padding:0 1rem;line-height:1.05}
.box__lid p{font-family:var(--f-carte);font-weight:600;color:var(--encre);font-size:clamp(1rem,2.6vmin,1.4rem)}
@keyframes lid{to{transform:rotateX(-96deg)}}
@keyframes pzIn{to{transform:rotate(0) scale(1)}}
@keyframes vapeur{0%{opacity:0;transform:translateY(0) scaleX(.8)}35%{opacity:.8}100%{opacity:0;transform:translateY(-14vmin) scaleX(1.25)}}
@keyframes introOut{to{opacity:0}}
[% endblock %]
[% block intro %]
  <div class="box__in">
    <div class="pz"><img src="[[ img(f.hero) ]]" alt=""></div>
    <div class="vapeur"><i></i><i></i><i></i></div>
  </div>
  <div class="box__lid">
    [% if f.logo %]<img src="[[ img(f.logo) ]]" alt="">[% else %]<div class="tampon">[[ f.nom ]]</div>[% endif %]
    <p>[[ f.activite ]]</p>
  </div>
[% endblock %]
[% block hero %]
  <section class="hero" id="accueil">
    <div class="page hero__grid">
      <div>
        <p class="hero__kicker">[[ f.accroche ]]</p>
        <h1 class="hero__title">[% for ln in f.titre_lignes|default([f.nom]) %]<span class="ln">[[ ln ]]</span>[% endfor %]</h1>
        [% if f.slogan %]<p class="hero__tag">[[ f.slogan ]]</p>[% endif %]
        <p class="status" data-status><span class="status__dot"></span><span data-status-text></span></p>
        <div class="actions">
          <a class="btn btn--p" href="tel:[[ f.tel ]]">Commander au [[ f.tel_affiche ]]</a>
          <a class="btn btn--t" href="#carte">Voir la carte</a>
        </div>
        [% if f.note %]<p class="preuve">Noté [[ f.note ]] sur 5 sur Google ([[ f.avis ]] avis)[% if f.preuve_extra %], [[ f.preuve_extra ]][% endif %].</p>[% endif %]
      </div>
      <div class="plat">
        <div class="assiette"></div>
        <div class="tourne" id="tourne"><img src="[[ img(f.hero) ]]" alt="[[ f.hero_alt|default(f.activite) ]]"></div>
        [% if f.logo %]<img class="sceau" src="[[ img(f.logo) ]]" alt="">[% endif %]
      </div>
    </div>
  </section>
[% endblock %]
[% block sections %]
  <section class="sec carte" id="carte">
    <div class="page">
      <div class="carte__head">
        <h2>[[ f.offre_titre|default("La carte") ]]</h2>
        [% if f.offre_intro %]<p class="lead">[[ f.offre_intro ]]</p>[% endif %]
      </div>
      <div class="carte__cols">
        [% for g in f.offre_groupes|default([{"titre": "", "items": f.offre}]) %]
        <div class="groupe">
          [% if g.titre %]<h3>[[ g.titre ]]</h3>[% endif %]
          <ul class="plats">
            [% for o in g["items"] %]<li><div class="plat__ligne"><span class="plat__nom">[[ o.titre ]]</span>[% if o.prix %]<span class="plat__prix">[[ o.prix ]]</span>[% endif %]</div>[% if o.texte %]<p class="plat__desc">[[ o.texte ]]</p>[% endif %]</li>[% endfor %]
          </ul>
        </div>
        [% endfor %]
        [% if f.notes %]<div class="carte__notes">[% for n in f.notes %]<p><strong>[[ n.k ]] :</strong> [[ n.v ]]</p>[% endfor %]</div>[% endif %]
      </div>
    </div>
  </section>
  [% if f.moment %]
  <section class="sec moment" id="moment">
    <div class="page">
      <h2>[[ f.moment.titre ]]</h2>
      [% if f.moment.intro %]<p class="lead">[[ f.moment.intro ]]</p>[% endif %]
      <ul class="moment__grid">
        [% for it in f.moment["items"] %]<li><img src="[[ img(it.img) ]]" alt="[[ it.alt|default(it.titre) ]]"><h3>[[ it.titre ]]</h3>[% if it.texte %]<p>[[ it.texte ]]</p>[% endif %]</li>[% endfor %]
      </ul>
    </div>
  </section>
  [% endif %]
  <section class="sec cmd" id="commander">
    <div class="page cmd__grid">
      <div>
        <h2>Commander</h2>
        <p class="lead">[[ f.commande_intro|default("Vous appelez, vous passez la prendre.") ]]</p>
      </div>
      <ol class="etapes">
        [% for e in f.etapes|default([{"titre": "Appelez-nous", "texte": "Au " ~ f.tel_affiche ~ ", pendant les heures d'ouverture."}, {"titre": "On la prépare", "texte": "Choisissez sur la carte, on s'occupe du reste."}, {"titre": "Vous passez la prendre", "texte": f.adresse ~ ", " ~ f.cp_ville ~ "."}]) %]
        <li><div><h3>[[ e.titre ]]</h3><p>[[ e.texte ]]</p></div></li>
        [% endfor %]
      </ol>
    </div>
  </section>
[% endblock %]
[% block js %]
  var tourne=document.getElementById("tourne");
  window.__auDefil(function(y){ if(y < window.innerHeight*1.3) tourne.style.transform="rotate("+(y*0.12).toFixed(1)+"deg)"; });
[% endblock %]
